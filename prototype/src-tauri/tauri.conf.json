{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nhịp Prototype",
  "version": "0.1.0",
  "identifier": "dev.nhip.performance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nhịp — Prototype",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4876 https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
